    ring_x = bpy.context.active_object
    ring_x.rotation_euler[0] = 1.5708
    ring_x.data.materials.append(emission_mat)
    # Create Y-axis spin ring
    bpy.ops.mesh.primitive_torus_add(major_radius=e_radius, minor_radius=e_radius/10, location=(loc_x, loc_y, loc_z + eloc_z))
    ring_y = bpy.context.active_object
    ring_y.rotation_euler[1] = 1.5708
    ring_y.data.materials.append(emission_mat)
