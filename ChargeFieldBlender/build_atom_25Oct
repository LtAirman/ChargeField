def create_SL_label(element_symbol, block_size=10.0, origin=(0,0,0)):
    # Create a label with the same size and text parameters as in the SL diagram
    #sl_parent = bpy.data.objects.new(f"{element_symbol}_SlotLayout", None)

    # -40 centers the SL on the x axis
    x = origin[0] - 40 - 2 * 8 * block_size + 40
    y = origin[1] - 0.1
    z = origin[2] + 3 * 4 * block_size
    
    # Create the colored plane
    bpy.ops.mesh.primitive_plane_add(size= 4 * block_size, location=(x, y, z))
    bpy.ops.transform.resize(value=(2, 1, 1))            
    bpy.ops.transform.rotate(value=1.5708, orient_axis='X')
    plane = bpy.context.active_object
    #plane.parent = sl_parent
