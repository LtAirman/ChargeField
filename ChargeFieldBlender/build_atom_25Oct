# Purpose:
# Represents a stack (one or more proton groups) in a given slot.
# Knows its orientation, position, and whether it can bind.
# Can merge with another stack if bonding rules allow.
# Possible Structure:         
class AtomicStack:
    def __init__(self, slot, protons, px, py, pz, orien, can_bind, stack_num):
        self.slot = slot
        self.protons = protons
        self.position = (px, py, pz)
        self.orien = orien
        self.can_bind = can_bind
        self.stack_num = stack_num

    def visualize(self):
        # Call your atomic_stack() or similar function here
        atomic_stack(
            atom="",
            slot=self.slot,
            protons=self.protons,
            px=self.position[0],
            py=self.position[1],
            pz=self.position[2],
            #p2p3=0.3,  # or whatever is appropriate
            p2p3=0.6,  # better
            orien=self.orien,
            can_bind=self.can_bind,
            stack_num=self.stack_num
        )

    def can_bond_with(self, other_stack):
