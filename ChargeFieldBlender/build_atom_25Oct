def add_proton(loc_x=0, loc_y=0, loc_z=0, type='BL', spin_mat=spin_mat_l):
    '''The proton'''
    #print('type = ', type)    
    bpy.ops.object.select_all(action='DESELECT')
    # Create the proton sphere
    bpy.ops.mesh.primitive_uv_sphere_add(radius = p_radius, location=(loc_x, loc_y, loc_z))
    proton = bpy.context.active_object
    bpy.ops.object.shade_smooth()
    if spin_mat:
        proton.data.materials.append(spin_mat)
    # Create X-axis spin marker ring
    bpy.ops.mesh.primitive_torus_add(major_radius=p_radius, minor_radius=p_radius/30, location=(loc_x, loc_y, loc_z))
    ring_x = bpy.context.active_object
    ring_x.rotation_euler[0] = 1.5708
    ring_x.data.materials.append(emission_mat)
    # Create Y-axis spin marker ring
    bpy.ops.mesh.primitive_torus_add(major_radius=p_radius, minor_radius=p_radius/30, location=(loc_x, loc_y, loc_z))
    ring_y = bpy.context.active_object
    ring_y.rotation_euler[1] = 1.5708
    ring_y.data.materials.append(emission_mat)
    # Join all into one object
    bpy.context.view_layer.objects.active = proton
    proton.select_set(True)
    ring_x.select_set(True)
    ring_y.select_set(True)
    bpy.ops.object.join()
    return bpy.context.active_object

