# Takes each single (1-19) slot's data as arguments.
# Places and orients each slot's stack (from all_stacks) at (px, py, pz) and adds a slot label.
def atomic_stack(atom, slot, protons, px, py, pz, p2p3, orien, can_bind, stack_num, label_height=3.0):
    """
    Place a single atomic stack at the specified coordinates and orientation.
    """
    if protons == 0:
        return None  # Skip empty slots
    # Get the stack configuration from all_stacks (stack_num is 1-based)
    
    # Ensure stack_num is an int
    if isinstance(stack_num, list):
        stack_num = stack_num[0]  # or random.choice(stack_num) for variation
    
    stack_text, _ = all_stacks[stack_num - 1]  # Errors with H and He
    #stack_text, _ = all_stacks[int(stack_num - 1)]  
    # Split stack_text into 2-letter group types
    group_types = [stack_text[i:i+2] for i in range(0, len(stack_text), 2)]  
    # Find the correct collection names
    group_collections = {
        'TR': 'TR_Collection',
        'TL': 'TL_Collection',
        'BR': 'BR_Collection',
        'BL': 'BL_Collection'}
    # Place each group in the stack along the stack axis
    for idx, group_type in enumerate(group_types):
        collection_name = group_collections.get(group_type)
        if collection_name is None:
            print(f"Unknown group: {group_type}")
            continue
        # Offset each group along the stack axis. Find the point at which the stack begins. 
        stackstart = (protons-1)*10*p2p3/2  # The distance fron stack center to end.
        # starckstart alone has a problem, as T or B type groups overlap by 1. 
        if orien == 'X':
            offset = (px - idx * 10 * p2p3 + stackstart, py, pz)
        elif orien == 'Y':
            offset = (px, py - idx * 10 * p2p3 + stackstart, pz) 
        elif orien == 'Z':
            offset = (px, py, pz - idx * 10 * p2p3 + stackstart)    
        else:
            offset = (px, py, pz)
        instance_name = f"{atom}_Slot{slot}_Group{group_type}_{idx+1}"
        instance_obj = instance_collection(bpy.data.collections[collection_name], offset, instance_name)
        # Rotate the instance according to orientation - assuming a z-axis default
        if instance_obj:
            if orien == 'X':
                instance_obj.rotation_euler = (0, math.pi/2, 0)
            elif orien == 'Y':
                instance_obj.rotation_euler = (-math.pi/2, 0, 0)
            elif orien == 'Z':
                instance_obj.rotation_euler = (0, 0, 0)
    # Add a 3D label at the stack position (only once per slot)
    bpy.ops.object.text_add(location=(px, py, pz + label_height)) 
    text_obj = bpy.context.object
    text_obj.name = f"{atom}_SlotLabel_{slot}"
    #text_obj.name = f"{atom}_Stack#{stack_num}"
    text_obj.data.body = f"{atom} Slot {slot}"
    #text_obj.data.body = f"S#{stack_num}"
    text_obj.data.align_x = 'CENTER'
    text_obj.data.extrude = 0.05
    text_obj.rotation_euler[0] = math.radians(90)
    bpy.ops.object.convert(target='MESH')
    stack_label = bpy.context.active_object
    stack_label.data.materials.append(text_mat)
    bpy.ops.object.select_all(action='DESELECT')
    return 

# Loops through each atom's 1-19 occupied slots and calls atomic_stack() for each:
# slot_spacing: Spreads out the centers of each stack, preventing overlap 
# between adjacent orthogonal stacks).
# p2p3: The distance between adjacent protons within each stack.
# scale: Overall atom size.
def build_atom(element_symbol, loc_x=0.0, loc_y=0.0, loc_z=0.0, scale=10.0, slot_spacing=2.0, variant="random"):
    
    #quick_Light(origin =(loc_x, loc_y, loc_z))
    
    atom = atomic_data[element_symbol]

    for slot in atom["slots"]:
        stack_nums = slot["stack_num"]
        if isinstance(stack_nums, list):
            if variant == "random":
                stack_num = random.choice(stack_nums)
            else:
                stack_num = stack_nums[0]  # or use variant as an index
        else:
            stack_num = stack_nums
        atomic_stack(
            atom=element_symbol,
            slot=slot["slot"],
            protons=slot["protons"],
            px=loc_x + slot["px"] * scale * slot_spacing,
            py=loc_y + slot["py"] * scale * slot_spacing,
            pz=loc_z + slot["pz"] * scale * slot_spacing,
            p2p3=slot["p2p3"]*2.0,
            orien=slot["orien"],
            can_bind=slot["can_bind"],
            stack_num=slot["stack_num"]
        ) 
    return
        
