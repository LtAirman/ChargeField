def select_collection_objects(collection_name):
    collection = bpy.data.collections.get(collection_name)
    if collection:
        for obj in collection.objects:
            obj.select_set(True)
    return          

def relocate_collection(loc_x=0.0, loc_y=0.0, loc_z=0.0, collection_name="BL_Collection", type='BL', spin_dir="L"):
    my_collection = bpy.data.collections.get(collection_name)
    if my_collection:
        # Find the proton object in the collection
        proton_obj = None
        for obj in my_collection.objects:
            if obj.name.endswith("proton"):
                proton_obj = obj
                break
        if proton_obj:
            # Move the proton (parent) to the new location
            proton_obj.location = (loc_x, loc_y, loc_z)
            bpy.context.view_layer.objects.active = proton_obj
            proton_obj.select_set(True)
        else:
            print(f"No proton found in collection '{collection_name}'.")
    else:
        print(f"Collection '{collection_name}' not found.")
    return
        
def instance_collection(collection, location, instance_name):
    # Create a collection instance
    empty = bpy.data.objects.new(name=instance_name, object_data=None)
    empty.instance_type = 'COLLECTION'
    empty.instance_collection = collection
    empty.location = location
    #bpy.ops.object.origin_set(type='GEOMETRY_ORIGIN', center='MEDIAN') # Crushed charge intakes
    bpy.context.scene.collection.objects.link(empty)
    # The next line relocates the group to their empties,
    bpy.ops.object.select_all(action='SELECT') # Brings instance objects to inst empties
    # That is not true now. All objects are selected. The 4 relocated collections look good 
    # all instance objects are offset from their correctly positioned empties.  
    bpy.ops.object.origin_set(type='GEOMETRY_ORIGIN', center='MEDIAN')
    #bpy.ops.object.origin_set(type='GEOMETRY_ORIGIN', center='BOUNDS') 
    return empty  # Return the instance object so build_all_stacks can randomize it.

def relocate_instance(instance_objects="BL_Collection_instance", type='BL', spin_dir="L"):
    obj = bpy.data.objects.get(instance_objects)
    #bpy.ops.object.origin_set(type='GEOMETRY_ORIGIN', center='MEDIAN')
    if obj:
        # Set the location directly instead of using bpy.ops.transform.translate
        #bpy.ops.object.origin_set(type='GEOMETRY_ORIGIN', center='MEDIAN')
        if type=='BL':
            obj.location = (-2*gap, -gap/2, 0.8-gap/2)
            #bpy.ops.object.origin_set(type='GEOMETRY_ORIGIN', center='MEDIAN')
            #obj.location = (-2*gap, -gap/2, 0.8-gap/2)
        elif type=='TL':
            obj.location = (-2*gap, -gap/2, -0.8+gap/2)
        elif type=='TR':
            obj.location = (-2*gap, gap/2, -0.8+gap/2)
        elif type=='BR':
            obj.location = (-2*gap, gap/2, 0.8-gap/2)
        bpy.ops.object.select_all(action='DESELECT')
        #bpy.ops.object.origin_set(type='GEOMETRY_ORIGIN', center='MEDIAN')
    return

# Creating an Atom class, with the goal of building molecules
# Represents a single atom, with all its slots, stacks, and metadata.
# Knows its own possible bonding sites (extremities).
# Can expose methods for checking and forming bonds.
# Possible Structure:
class Atom:
    def __init__(self, element_symbol, loc_x=0.0, loc_y=0.0, loc_z=0.0, scale=1.0):
        self.symbol = element_symbol
        self.data = atomic_data[element_symbol]
        self.location = (loc_x, loc_y, loc_z)
        self.scale = scale
        self.stacks = []  # List of AtomicStack objects
        self.build_stacks()

    def build_stacks(self):
        for slot in self.data["slots"]:
            stack = AtomicStack(
                slot=slot["slot"],
                protons=slot["protons"],
                px=self.location[0] + slot["px"] * self.scale,
                py=self.location[1] + slot["py"] * self.scale,
                pz=self.location[2] + slot["pz"] * self.scale,
                orien=slot["orien"],
                can_bind=slot["can_bind"],
                stack_num=slot["stack_num"]
            )
            self.stacks.append(stack)

    def get_extremities(self):
        # Return a list of stacks that are at the atom's extremities and can bind
        return [stack for stack in self.stacks if stack.can_bind == 'Y']

    def visualize(self):
        for stack in self.stacks:
            stack.visualize()    
                    

