def add_pro_neu_elec_emission_intake(loc_x, loc_y, loc_z, eloc_z=-e_locz, incl_neutron = False, nloc_z=n_locz, type = 'BL', spin_mat = spin_mat_l, x_coef=1, z_coef=1):
    # Add the proton group objects and their animation spin drivers
    spin_dir = "L" if spin_mat == spin_mat_l else "R"
    collection_name = f"{type}_Collection"
    My_collection = bpy.data.collections.new(collection_name)    
    bpy.context.scene.collection.children.link(My_collection)
    # Add proton
    proton_angle = random.uniform(0, 2 * math.pi)
    px = math.cos(proton_angle)
    py = math.sin(proton_angle)
    pz = loc_z
    proton = add_proton(loc_x, loc_y, loc_z, type, spin_mat)
    #proton = add_proton(px, py, pz, type, spin_mat)
    proton.rotation_euler[2] = random.uniform(0, 6.2832)  # Random z rotation (0 to 2pi)
    # The randon proton rotation here will apply to every instance of that collection. 
    # Four instance types -- there are only four groups.  
    proton.name = f"{type}proton"
    proton.data.name = f"{type}proton"
    My_collection.objects.link(proton)
    # Add proton's axial spin driver - spinning all the proton's children.
    add_continuous_rotation(proton, axis_index=2, speed=0.1, spin_dir=spin_dir)
    # Add neutron
    if incl_neutron == True: 
        # Add orbital empty at proton center, parented to proton and parent to the neutron
        bpy.ops.object.empty_add(type='PLAIN_AXES', radius=0.75, location=(loc_x, loc_y, loc_z))
        #bpy.ops.object.empty_add(type='PLAIN_AXES', radius=1.00, location=(rand_x, rand_y, rand_z))
        norbit_empty = bpy.context.active_object
        norbit_empty.rotation_euler[2] = random.uniform(0, 6.2832)  # Random z rotation (0 to 2pi)
        norbit_empty.name = f"{type}orbit"
        norbit_empty.parent = proton
        My_collection.objects.link(norbit_empty) 
        neutron_angle = random.uniform(0, 2 * math.pi)
        nx = n_radius * 1.75 * math.cos(neutron_angle)
        ny = n_radius * 1.75 * math.sin(neutron_angle) 
        nz = nloc_z
        neutron = add_neutron(nx, ny, nz, nloc_z=0, type=type, spin_mat=spin_mat)
        neutron.rotation_euler[2] = random.uniform(0, 6.2832)
        neutron.name = f"{type}neutron"
        neutron.data.name = f"{type}neutron"
        neutron.parent = norbit_empty
        My_collection.objects.link(neutron)
        # Add drivers for neutron axial spin and orbital rotation
        add_continuous_rotation(neutron, axis_index=2, speed=0.05, spin_dir=spin_dir)
        add_continuous_rotation(norbit_empty, axis_index=2, speed=-0.025, spin_dir=spin_dir)
    # Add electron 
    # Add orbital empty at proton center, parented to proton and parent to the electron
    bpy.ops.object.empty_add(type='PLAIN_AXES', radius=0.75, location=(loc_x, loc_y, loc_z))
    #bpy.ops.object.empty_add(type='PLAIN_AXES', radius=1.00, location=(rand_x, rand_y, rand_z))
    eorbit_empty = bpy.context.active_object
    eorbit_empty.rotation_euler[2] = random.uniform(0, 6.2832)  # Random z rotation (0 to 2pi)
    eorbit_empty.name = f"{type}orbit"
    eorbit_empty.parent = proton
    My_collection.objects.link(eorbit_empty)
    # --- Add randomness to electron orbital radius and angle ---
    # Location randomness is not needed yet, included for possible future alternative 
    #electron_radius = 0.25 + random.uniform(0, 0.25)
    #electron_radius = 0.25 
    electron_angle = random.uniform(0, 2 * math.pi)
    #ex = rand_x + electron_radius * math.cos(electron_angle)
    #ey = rand_y + electron_radius * math.sin(electron_angle)
    #ez = rand_z + eloc_z
    ex = e_radius * math.cos(electron_angle)
    ey = e_radius * math.sin(electron_angle)
    ez = eloc_z
    electron = add_electron(ex, ey, ez, eloc_z=0, type=type, spin_mat=spin_mat)
    electron.rotation_euler[2] = random.uniform(0, 6.2832)
    electron.name = f"{type}electron"
    electron.data.name = f"{type}electron"
    electron.parent = eorbit_empty
    My_collection.objects.link(electron)
    # Add drivers for electron axial spin and orbital rotation
    add_continuous_rotation(electron, axis_index=2, speed=0.2, spin_dir=spin_dir)
    add_continuous_rotation(eorbit_empty, axis_index=2, speed=0.15, spin_dir=spin_dir)
    # Add emission
    emission = add_emission(loc_x, loc_y, loc_z)
    emission.name = f"{type}emission"
    emission.data.name = f"{type}emission"
    emission.data.materials.append(emission_mat)
    emission.parent = proton    
    My_collection.objects.link(emission)
    # 'Spin' the emission at negative proton speed.
    add_continuous_rotation(emission, axis_index=2, speed=-0.1, spin_dir=spin_dir)
    # Add thrucharge
    #thrucharge = add_thrucharge(loc_x, loc_y, c_loc_z, type='BL', spin_mat=spin_mat_l)
    thrucharge = add_thrucharge(loc_x, loc_y, loc_z) 
    # Trying to slide the beam down or up for the two vertically adjacent B and T protons
    if type == 'BL': 
        end = -2.25
    if type == 'BR': 
        end = -2.25
    if type == 'TL': 
        end = 2.25
    if type == 'TR': 
        end = 2.25
    bpy.ops.transform.translate(value=(0, 0, end))
    thrucharge.name = f"{type}thrucharge"
    thrucharge.data.name = f"{type}thrucharge"
    thrucharge.data.materials.append(spin_mat)
    thrucharge.parent = proton    
    My_collection.objects.link(thrucharge)
    # 'Spin' the emission at negative proton speed.
    add_continuous_rotation(thrucharge, axis_index=2, speed=-0.1, spin_dir=spin_dir)   
    #bpy.ops.object.select_all(action='DESELECT')
    # Add intake # 
    # Add intake_empty at proton center, parented to proton
    bpy.ops.object.empty_add(type='PLAIN_AXES', radius=0.75, location=(loc_x, loc_y, loc_z))
    #bpy.ops.object.empty_add(type='PLAIN_AXES', radius=1.00, location=(rand_x, rand_y, rand_z))
    intake_empty = bpy.context.active_object
    intake_empty.rotation_euler[2] = random.uniform(0, 6.2832)  # Random z rotation (0 to 2pi)
    intake_empty.name = f"{type}orbit"
    intake_empty.parent = proton
    My_collection.objects.link(intake_empty)
    intake_angle = random.uniform(0, 2 * math.pi) ### making the random more obvious
    intake = add_intake(loc_x, loc_y, loc_z, x_coef, z_coef)
    intake.rotation_euler[2] = intake_angle  # random intake strating angle, only four.
    intake.name = f"{type}intake"
    intake.data.name = f"{type}intake"
    intake.data.materials.append(spin_mat)
    intake.parent = intake_empty
    My_collection.objects.link(intake)
    add_continuous_rotation(intake_empty, axis_index=2, speed=0.05, spin_dir=spin_dir)
    bpy.ops.object.select_all(action='DESELECT')
    return

class ProtonGroup:
    def __init__(self, group_type, loc_x=0.0, loc_y=0.0, loc_z=0.0):
        self.group_type = group_type.upper()
        self.loc_x = loc_x
        self.loc_y = loc_y
        self.loc_z = loc_z
        # Set parameters based on group type
        if self.group_type == 'TL':
            self.eloc_z = e_locz
            self.nloc_z = -n_locz
            self.spin_mat = spin_mat_l
            self.x_coef = 1
            self.z_coef = -1
        elif self.group_type == 'BL':
            self.eloc_z = -e_locz
            self.nloc_z = n_locz
            self.spin_mat = spin_mat_l
            self.x_coef = 1
            self.z_coef = 1
        elif self.group_type == 'TR':
            self.eloc_z = e_locz
            self.nloc_z = -n_locz
            self.spin_mat = spin_mat_r
            self.x_coef = -1
            self.z_coef = -1
        elif self.group_type == 'BR':
            self.eloc_z = -e_locz
            self.nloc_z = n_locz
            self.spin_mat = spin_mat_r
            self.x_coef = -1
            self.z_coef = 1
        else:
            raise ValueError(f"Unknown group type: {self.group_type}")

    def build(self, incl_neutron=True):
        add_pro_neu_elec_emission_intake(
            self.loc_x, self.loc_y, self.loc_z,
            eloc_z=self.eloc_z,
            nloc_z=self.nloc_z,
            type=self.group_type,
            spin_mat=self.spin_mat,
            x_coef=self.x_coef,
            z_coef=self.z_coef,
            incl_neutron=incl_neutron)
        return bpy.context.active_object

