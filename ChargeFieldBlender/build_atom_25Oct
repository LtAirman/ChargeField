# Emit particles one at a time from random locations within ±40° or 
# +/-20 latitude, modify emit_particles_in_latitude_band() so that 
# each particle is created and animated at a different start frame. 
# creating a continuous emission effect.
def emit_particles_in_latitude_band_continuous(
    pro_obj,
    num_particles=50,
    emission_radius=0.5,
    emission_speed=0.1,
    start_frame=1,
    end_frame=360,
    lat_min_deg=-40,
    lat_max_deg=40,
    particle_radius=0.05,
    frame_interval=2):
    """
    Emit particles one at a time from a latitude band around a proton object.
    Each particle is released at a different frame for a continuous effect.
    """
    lat_min = math.radians(lat_min_deg)
    lat_max = math.radians(lat_max_deg)
    for i in range(num_particles):
        latitude = random.uniform(lat_min, lat_max)
        longitude = random.uniform(0, 2 * math.pi)
        release_frame = start_frame + i * frame_interval
        # Spherical coordinates to Cartesian
        x = pro_obj.location.x + emission_radius * math.cos(latitude) * math.cos(longitude)
        y = pro_obj.location.y + emission_radius * math.cos(latitude) * math.sin(longitude)
        z = pro_obj.location.z + emission_radius * math.sin(latitude)
        bpy.ops.mesh.primitive_uv_sphere_add(radius=particle_radius, location=(x, y, z))
        particle = bpy.context.active_object
        particle.name = f"{pro_obj.name}_latband_particle_{i}"
        # Animate particle moving outward from its release frame
        for frame in range(release_frame, end_frame):
            r = emission_radius + emission_speed * (frame - release_frame)
            particle.location.x = pro_obj.location.x + r * math.cos(latitude) * math.cos(longitude)
            particle.location.y = pro_obj.location.y + r * math.cos(latitude) * math.sin(longitude)
            particle.location.z = pro_obj.location.z + r * math.sin(latitude)
            particle.keyframe_insert(data_path="location", frame=frame)
    return 


